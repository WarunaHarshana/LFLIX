# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.

# ── Required ────────────────────────────────────────────────────────────────

# PIN used to sign in. Set this: leaving it unset falls back to a well-known
# default. Digits only, 4-64 characters.
APP_PIN=

# TMDB API key, used for posters, ratings, Discover and episode metadata.
# Get a free one at https://www.themoviedb.org/settings/api
# Without it the library still scans, but titles come from filenames only.
# Can also be set per-install in Settings, which takes precedence over this.
TMDB_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# OMDb API key. Adds IMDb ratings alongside TMDB scores.
# http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Set to 1 to allow downloads from private/loopback addresses. Off by default
# because the server performs these fetches, so an unrestricted URL would let a
# caller probe your local network. Only enable for a self-hosted source.
ALLOW_PRIVATE_DOWNLOAD_URLS=

# Extra open-directory roots for direct downloads, comma-separated.
DDL_OPEN_DIR_BASES=

# Narrow the paths searched under those roots, comma-separated.
DDL_OPEN_DIR_PATHS=
DDL_OPEN_DIR_MOVIE_PATHS=
DDL_OPEN_DIR_TV_PATHS=

# Base URL for the CoorenLabs PrimeSrc stream provider.
COOREN_API_URL=
